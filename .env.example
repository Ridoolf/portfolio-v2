# EmailJS — https://www.emailjs.com/
# Copiá este archivo como `.env` y reemplazá los valores con los tuyos.
# En el template de EmailJS, configurá "To Email" con tu correo
# y usá estas variables: {{from_name}}, {{from_email}}, {{reply_to}}, {{message}}

VITE_EMAILJS_SERVICE_ID=tu_service_id
VITE_EMAILJS_TEMPLATE_ID=tu_template_id
VITE_EMAILJS_PUBLIC_KEY=tu_public_key

# URL del sitio en producción (referencia para deploy)
VITE_SITE_URL=https://lucasridolfi.com.ar
